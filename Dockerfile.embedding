FROM pytorch/pytorch:2.7.0-cuda12.8-cudnn9-runtime

RUN pip install --no-cache-dir \
    fastapi==0.115.* \
    uvicorn[standard]==0.34.* \
    transformers==4.48.* \
    accelerate==1.3.* \
    bitsandbytes==0.45.* \
    qdrant-client==1.13.* \
    numpy \
    pydantic==2.*

WORKDIR /app
COPY service/ /app/

EXPOSE 8100

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8100"]
